# Twilio credentials
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio WhatsApp sender, e.g. whatsapp:+1415XXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Optional admin/recipient number to use when `to` isn't provided (format +5511999999999)
ADMIN_WHATSAPP_NUMBER=+55XXXXXXXXXXX

