# Twilio credentials
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio WhatsApp sender, e.g. whatsapp:+1415XXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Optional admin/recipient number to use when `to` isn't provided (format +5511999999999)
ADMIN_WHATSAPP_NUMBER=+55XXXXXXXXXXX

# Email (SMTP) settings
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=app_password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Your Name <no-reply@yourdomain.com>
ADMIN_EMAIL=your.email@example.com
# Quem receberá os relatórios (por padrão usa ADMIN_EMAIL)
REPORT_TO=guimota1@gmail.com
# Usuário cujo relatório será gerado. O script usa primeiro REPORT_USER_ID (Firebase UID).
# Se REPORT_USER_ID não for definido, ele busca o usuário por email no Auth e, em último caso, tenta consulta ao Firestore users/{uid}.
REPORT_USER_ID=
REPORT_USER_EMAIL=guimota1@gmail.com
# Configure um caminho para o service account JSON do Firebase
# Exemplo: C:\path\to\serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=
# Ou cole o JSON do service account diretamente na variável abaixo
FIREBASE_SERVICE_ACCOUNT=

